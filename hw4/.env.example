# Copy to .env (in this folder or any parent folder) and fill in your own key.
# Never commit the real .env.

# Portkey gateway key used by the PydanticAI agent (backend/agent.py)
PORTKEY_API_KEY=your_portkey_api_key_here

# Model for the chat agent (optional; this is the default)
OPENAI_MODEL=gpt-5.6-luna

# Only needed if you use the original seed accounts' 3-part password hashes
# CC_LEGACY_PBKDF2_ITERATIONS=
